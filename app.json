{
  "expo": {
    "name": "Who Owes Me?",
    "slug": "who-owes-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wom-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/wom-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/wom-icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.mzatilife.whoowesme"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/wom-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-local-authentication",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d843919-71a2-4f86-9de6-cfa042ddf34d"
      }
    }
  }
}
